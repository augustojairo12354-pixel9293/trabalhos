          escreva("\n- ", qtd5, " nota(s) de R$ 5")
          escreva("\n- ", qtd1, " nota(s) de R$ 1\n")
          pare
        caso 27:
          escreva("--- QUESTÃO 27 (Cálculo de Peças com IPI) ---\n")
