programa {
  inclua biblioteca Matematica --> mat

  funcao inicio() {
    real ladoA, ladoB, ladoC, maiorLado, l2, l3
    real semiPerimetro, areaTriangulo

    escreva("--- QUESTÃO 23 (Validação de Triângulo) ---\n")
    escreva("Digite o lado A: ") 
    leia(ladoA)
    escreva("Digite o lado B: ") 
    leia(ladoB)
    escreva("Digite o lado C: ") 
    leia(ladoC)
    se (ladoA >= ladoB e ladoA >= ladoC) {
      maiorLado = ladoA
      l2 = ladoB
      l3 = ladoC
    } senao se (ladoB >= ladoA e ladoB >= ladoC) {
      maiorLado = ladoB
      l2 = ladoA
      l3 = ladoC
    } senao {
      maiorLado = ladoC
      l2 = ladoA
      l3 = ladoB
    }
    se (maiorLado >= (l2 + l3)) {
      escreva("\nOs valores nao formam um triangulo conforme a regra (maior lado >= soma dos outros).\n")
      escreva("Valores lidos: ", ladoA, " | ", ladoB, " | ", ladoC, "\n")
    } senao {
      semiPerimetro = (ladoA + ladoB + ladoC) / 2.0
      areaTriangulo = mat.raiz(semiPerimetro * (semiPerimetro - ladoA) * (semiPerimetro - ladoB) * (semiPerimetro - ladoC), 2.0)     
      escreva("\nOs lados formam um triangulo perfeito!\n")
      escreva("Area do triangulo: ", mat.arredondar(areaTriangulo, 2), "\n")
    }
  }
} 
