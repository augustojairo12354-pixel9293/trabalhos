          escreva("Digite a nota 1: ") leia(n1)
          escreva("Digite a nota 2: ") leia(n2)
          escreva("Digite a nota 3: ") leia(n3)
          escreva("Digite a média dos exercícios: ") leia(mediaExercicios)   
          mediaAproveitamento = (n1 + (n2 * 2.0) + (n3 * 3.0) + mediaExercicios) / 7.0
          se (mediaAproveitamento >= 9.0) {
            conceito = "A"
            statusAluno = "APROVADO"
          } senao se (mediaAproveitamento >= 7.5) {
            conceito = "B"
            statusAluno = "APROVADO"
          } senao se (mediaAproveitamento >= 6.0) {
            conceito = "C"
            statusAluno = "APROVADO"
          } senao se (mediaAproveitamento >= 4.0) {
            conceito = "D"
            statusAluno = "REPROVADO"
