programa {
	inclua biblioteca Matematica --> mat
	inclua biblioteca Util --> u
	funcao inicio() {
		inteiro opcao = -1
		inteiro a, b, c, totalDias, anos, meses, dias, segundos
		real n1, n2, n3, media, r, s, d, denominador, custoFabrica

		enquanto (opcao != 0) {
			escreva("\n=================== EXERCÍCIOS (1 A 10) ===================")
			escreva("\n1  - Distância entre dois pontos: Calcula o espaço entre P1(x1,y1) e P2(x2,y2)")
			escreva("\n2  - Expressão D: Calcula D = (R + S) / 2 a partir de três inteiros")
			escreva("\n3  - Idade em Dias: Converte uma idade em anos, meses e dias para total de dias")
			escreva("\n4  - Dias para Idade: Transforma o total de dias de volta em anos, meses e dias")
			escreva("\n5  - Média Ponderada: Calcula a nota final usando os pesos 2, 3 e 5")
			escreva("\n6  - Tempo de Fábrica: Converte segundos em horas, minutos e segundos")
			escreva("\n7  - Custo do Carro: Soma o custo de fábrica com 28% do distribuidor e 45% de impostos")
			escreva("\n8  - Sistema Linear: Resolve equações lineares para encontrar os valores de X e Y")
			escreva("\n9  - Média Aritmética: Tira a média simples de 3 notas e diz se foi Aprovado (>= 6)")
			escreva("\n10 - Maior de 3: Lê três números reais e mostra qual é o maior deles")
			escreva("\n0  - Sair do programa")
			escreva("\n======================================================================")
			escreva("\nDigite a opção desejada(1 a 10): ")
			leia(opcao)			
			limpa()			
			escolha (opcao) {
				caso 1:
					escreva("--- QUESTÃO 1 (Distância entre dois pontos) ---\n")
					real x1, y1, x2, y2
					escreva("Ponto 1 - Digite x1: ") 
					leia(x1)
					escreva("Ponto 1 - Digite y1: ") 
					leia(y1)
					escreva("Ponto 2 - Digite x2: ") 
					leia(x2)
					escreva("Ponto 2 - Digite y2: ") 
					leia(y2)					
					d = mat.raiz(mat.potencia(x2 - x1, 2.0) + mat.potencia(y2 - y1, 2.0), 2.0)
					escreva("Distância final calculada: ", mat.arredondar(d, 4), "\n")
					pare
				caso 2:
					escreva("--- QUESTÃO 2 (Expressão D) ---\n")
					escreva("Digite o valor de A: ") 
					leia(a)
					escreva("Digite o valor de B: ") 
					leia(b)
					escreva("Digite o valor de C: ") 
					leia(c)				
					r = mat.potencia((a + b) * 1.0, 2.0)
					s = mat.potencia((b + c) * 1.0, 2.0)
					escreva("Resultado da expressão D: ", (r + s) / 2.0, "\n")
					pare
				caso 3:
					escreva("--- QUESTÃO 3 (Idade em Dias) ---\n")
					escreva("Digite os Anos: ") 
					leia(anos)
					escreva("Digite os Meses: ") 
					leia(meses)
					escreva("Digite os Dias: ") 
					leia(dias)					
					escreva("Sua idade convertida totaliza: ", (anos * 365) + (meses * 30) + dias, " dias.\n")
					pare
				caso 4:
					escreva("--- QUESTÃO 4 (Dias para Anos/Meses/Dias) ---\n")
					escreva("Digite a idade expressa em dias: ") 
					leia(totalDias)					
					escreva(totalDias / 365, " ano(s), ", (totalDias % 365) / 30, " mês(es) e ", (totalDias % 365) % 30, " dia(s).\n")
					pare
				caso 5:
					escreva("--- QUESTÃO 5 (Média Ponderada 2, 3, 5) ---\n")
					escreva("Digite a nota 1: ") 
					leia(n1)
					escreva("Digite a nota 2: ") 
					leia(n2)
					escreva("Digite a nota 3: ") 
					leia(n3)					
					media = ((n1 * 2) + (n2 * 3) + (n3 * 5)) / 10
					escreva("A média ponderada final é: ", mat.arredondar(media, 2), "\n")
					pare
				caso 6:
					escreva("--- QUESTÃO 6 (Tempo em segundos) ---\n")
					escreva("Digite a duração em segundos: ") 
					leia(segundos)					
					escreva("Formatado: ", segundos / 3600, "h ", (segundos % 3600) / 60, "m ", (segundos % 3600) % 60, "s\n")
					pare
				caso 7:
					escreva("--- QUESTÃO 7 (Custo do Carro Novo) ---\n")
					escreva("Digite o custo de fábrica: R$ ") 
					leia(custoFabrica)					
					escreva("Custo total ao consumidor: R$ ", mat.arredondar(custoFabrica * 1.73, 2), "\n")
					pare
				caso 8:
					escreva("--- QUESTÃO 8 (Sistema de Equações Lineares) ---\n")
					real coefA, coefB, coefC, coefD, coefE, coefF
					escreva("Digite a: ") leia(coefA)
					escreva("Digite b: ") leia(coefB)
					escreva("Digite c: ") leia(coefC)
					escreva("Digite d: ") leia(coefD)
					escreva("Digite e: ") leia(coefE)
					escreva("Digite f: ") leia(coefF)				
					denominador = (coefA * coefE) - (coefB * coefD)
					se (denominador != 0) {
						escreva("X = ", mat.arredondar(((coefC * coefE) - (coefB * coefF)) / denominador, 2))
						escreva(" | Y = ", mat.arredondar(((coefA * coefF) - (coefC * coefD)) / denominador, 2), "\n")
					} senao { escreva("O sistema não possui solução (divisão por zero).\n") }
					pare
				caso 9:
					escreva("--- QUESTÃO 9 (Média Aritmética e Status) ---\n")
					escreva("Digite a nota 1: ") leia(n1)
					escreva("Digite a nota 2: ") leia(n2)
					escreva("Digite a nota 3: ") leia(n3)					
					media = (n1 + n2 + n3) / 3
					escreva("Média calculada: ", mat.arredondar(media, 2))
					se (media >= 6.0) { escreva(" -> APROVADO\n") } senao { escreva(" -> REPROVADO\n") }
					pare
				caso 10:
					escreva("--- QUESTÃO 10 (Maior de 3 Valores) ---\n")
					escreva("Digite o primeiro valor: ") leia(n1)
					escreva("Digite o segundo valor: ") leia(n2)
					escreva("Digite o terceiro valor: ") leia(n3)					
					real maior = n1
					se (n2 > maior) maior = n2
					se (n3 > maior) maior = n3
					escreva("Valores digitados: ", n1, ", ", n2, ", ", n3, " | Maior valor: ", maior, "\n")
					pare					
				caso 0:
					escreva("Encerrando o programa...\n")
          u.aguarde(1500)
          limpa()
          escreva("\nPrograma encerrado! ")
          escreva("\nAté a proxíma chefia 👋😁")
					pare
				caso contrario:
					escreva("Opção inválida! Escolha apenas números de 1 a 10.\n")
			}			
			se (opcao != 0) {
				u.aguarde(6500)
				limpa()
			}
		}
	}
}



