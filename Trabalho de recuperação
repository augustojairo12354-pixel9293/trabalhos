  funcao inicio() {
    inteiro opcao = -1
    inteiro dinheiroLido, restoNotas
    inteiro qtd100, qtd50, qtd10, qtd5, qtd1
    real ipi, valorPeca1, valorPeca2, valorTotalPecas
    inteiro codPeca1, qtdPeca1, codPeca2, qtdPeca2
    inteiro hInicio, mInicio, hFim, mFim
    inteiro totalMinutosInicio, totalMinutosFim, diferencaMinutos, duracaoH, duracaoM
    inteiro numIdentificacao
    real n1, n2, n3, mediaExercicios, mediaAproveitamento
    cadeia conceito, statusAluno
    real indicePoluicao
    real termo1, termo2, termo3, termo4, termo5
    real e3, e4, e5

    enquanto (opcao != 0) {
      escreva("\n=================== EXERCÍCIOS (26 A 31) ===================")
      escreva("\n26 - Decomposição de Notas: Menor número de cédulas para um valor")
