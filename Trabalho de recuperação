          escreva("\nCódigo da peça 2: ") leia(codPeca2)
          escreva("Valor unitário da peça 2: R$ ") leia(valorPeca2)
          escreva("Quantidade de peças 2: ") leia(qtdPeca2)
          valorTotalPecas = (valorPeca1 * qtdPeca1 + valorPeca2 * qtdPeca2) * (ipi / 100.0 + 1.0)
          escreva("\nValor total a ser pago: R$ ", mat.arredondar(valorTotalPecas, 2), "\n")
          pare
        caso 28:
          escreva("--- QUESTÃO 28 (Duração do Jogo com Minutos) ---\n")
          escreva("Hora de início (0 a 23): ") leia(hInicio)
