      escreva("\nDigite a opção desejada (26 a 31, ou 0 para sair): ")
      leia(opcao)      
      limpa()      
      escolha (opcao) {
        caso 26:
         escreva("--- QUESTÃO 26 (Decomposição de Notas) ---\n")
          escreva("Digite o valor em reais (inteiro): R$ ")
          leia(dinheiroLido)
          qtd100 = dinheiroLido / 100
          restoNotas = dinheiroLido % 100
          qtd50 = restoNotas / 50
          restoNotas = restoNotas % 50
          qtd10 = restoNotas / 10
          restoNotas = restoNotas % 10
          qtd5 = restoNotas / 5
          qtd1 = restoNotas % 5
          escreva("\nValor lido: R$ ", dinheiroLido)
          escreva("\nRelação de notas necessárias:")
          escreva("\n- ", qtd100, " nota(s) de R$ 100")
          escreva("\n- ", qtd50, " nota(s) de R$ 50")
